{
  "name": "ioserver-oidc",
  "version": "0.5.0",
  "description": "IOServer middleware set for auth-service native OIDC and generic OAuth2/OIDC JWT authentication",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:major": "pnpm version major --no-git-tag-version",
    "gpr-setup": "node scripts/gpr.cjs",
    "gpr-restore": "node scripts/gpr-restore.cjs",
    "prepublishOnly": "pnpm run build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.md\""
  },
  "keywords": [
    "ioserver",
    "oidc",
    "oauth2",
    "jwt",
    "middleware",
    "fastify",
    "socket.io",
    "auth-service",
    "litellm",
    "wallet"
  ],
  "author": "x42en <https://github.com/x42en>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/x42en/ioserver-oidc.git"
  },
  "homepage": "https://github.com/x42en/ioserver-oidc#readme",
  "bugs": {
    "url": "https://github.com/x42en/ioserver-oidc/issues"
  },
  "peerDependencies": {
    "ioserver": ">=2.3.0"
  },
  "dependencies": {
    "@circle-rd/auth-ai": "^0.6.0",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fastify": "^5.12.8",
    "ioserver": "^2.3.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
